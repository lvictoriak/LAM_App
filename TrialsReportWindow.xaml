<Window x:Class="LAM_App.TrialsReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отчет по пробным" Height="400" Width="500"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Период отчета" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

            <WrapPanel Margin="0,0,0,20">
                <TextBlock Text="С:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <DatePicker x:Name="dpFrom" Width="150" Margin="0,0,20,0"/>
                <TextBlock Text="По:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <DatePicker x:Name="dpTo" Width="150"/>
            </WrapPanel>

            <Button Content="Сформировать" Width="200" Height="35" Click="generate_btn_Click" Background="#FF0068" Foreground="White" BorderBrush="Transparent" Margin="0,0,0,20"/>

            <Border Background="#F0F0F0" Padding="15" CornerRadius="8">
                <StackPanel>
                    <TextBlock x:Name="txtTotal" Text="Всего записей: 0" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock x:Name="txtScheduled" Text="На пробном: 0" Foreground="Blue"/>
                    <TextBlock x:Name="txtAttended" Text="Пришли: 0" Foreground="Green"/>
                    <TextBlock x:Name="txtBought" Text="Купили: 0" Foreground="DarkGreen" FontWeight="Bold"/>
                    <TextBlock x:Name="txtOther" Text="Другое: 0" Foreground="Gray"/>
                </StackPanel>
            </Border>

            <Button Content="Закрыть" Width="100" Height="30" Margin="0,20,0,0" HorizontalAlignment="Right" Click="close_btn_Click"/>
        </StackPanel>
    </Grid>
</Window>