<Window x:Class="LAM_App.EditAttendanceMarkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактировать отметку" Height="310" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Background="White" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtTitle" Grid.Row="0" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="1" Text="Отметка:" FontWeight="Bold" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="1" x:Name="cbMarkType" Height="30" Margin="95,0,0,12">
            <ComboBoxItem Content="Занятие" Tag="present"/>
            <ComboBoxItem Content="н - пропуск со списанием" Tag="absent"/>
            <ComboBoxItem Content="нб - справка без списания" Tag="medical"/>
            <ComboBoxItem Content="Очистить ячейку" Tag="clear"/>
        </ComboBox>

        <TextBlock Grid.Row="2" Text="Списать:" FontWeight="Bold" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="2" x:Name="cbWriteOffCount" Height="30" Width="120" HorizontalAlignment="Left" Margin="95,0,0,12">
            <ComboBoxItem Content="1" IsSelected="True"/>
            <ComboBoxItem Content="2"/>
        </ComboBox>

        <TextBlock Grid.Row="3" Text="Обычный пропуск списывает занятие с абонемента. Справка не списывает занятие и продлевает остаток."
                   Foreground="#666" TextWrapping="Wrap" VerticalAlignment="Top"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Width="110" Height="34" Margin="0,0,10,0"
                    Background="#E5E5E5" BorderBrush="Transparent" Click="cancel_btn_Click"/>
            <Button Content="Сохранить" Width="130" Height="34"
                    Background="#FF0068" Foreground="White" BorderBrush="Transparent" Click="save_btn_Click"/>
        </StackPanel>
    </Grid>
</Window>
