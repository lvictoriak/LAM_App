<Window x:Class="LAM_App.ClientsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Клиенты" Height="750" Width="1400"
        WindowStartupLocation="CenterScreen">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Background="#FF0068">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Logo -->
            <Button Grid.Column="0" Click="Logo_Click" Background="Transparent" BorderBrush="Transparent" Cursor="Hand" Margin="10,0,0,0">
                <Image Source="/Resources/Снимок экрана_10-5-2026_71352_.jpeg" Height="45" Stretch="Uniform"/>
            </Button>

            <TextBlock Grid.Column="1" Text="Клиенты" FontSize="32" FontWeight="Medium" 
                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Menu Button -->
            <Button Grid.Column="2" Name="menu_btn" Width="60" Background="Transparent" BorderBrush="Transparent" 
                    Margin="0,0,15,0" ToolTip="Открыть меню" Click="menu_btn_Click">
                <Image Source="/Resources/меню иконка.png" Height="35" Stretch="Uniform" Cursor="Hand"/>
            </Button>

            <!-- Popup Menu -->
            <Popup Name="menuPopup" Placement="Right" PlacementTarget="{Binding ElementName=menu_btn}" 
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="#FFB6D4" BorderBrush="#FF0068" BorderThickness="2" CornerRadius="8" Padding="5" Width="200">
                    <StackPanel>
                        <Button Content="Тренеры" Height="45" Background="#FFB6D4" BorderBrush="Transparent" 
                                FontSize="16" Cursor="Hand" Margin="0,0,0,2" Click="teachers_btn_Click"/>
                        <Button Content="Направления" Height="45" Background="#FFB6D4" BorderBrush="Transparent" 
                                FontSize="16" Cursor="Hand" Click="styles_btn_Click"/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="10" MinWidth="1100">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- DataGrid with Clients -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="GroupsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Border Background="#E6E6E6"
                                        CornerRadius="4"
                                        Margin="0,0,0,10"
                                        Padding="10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding GroupName}"
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   Foreground="Black"/>
                                        <TextBlock Text=" "
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   Foreground="Black"/>
                                        <TextBlock Text="{Binding GroupSchedule}"
                                                   FontWeight="Bold"
                                                   FontSize="14"
                                                   Foreground="Black"/>
                                    </StackPanel>
                                </Border>

                                <DataGrid AutoGenerateColumns="False"
                                          IsReadOnly="False"
                                          SelectionMode="Single"
                                          CanUserAddRows="False"
                                          GridLinesVisibility="Horizontal"
                                          HeadersVisibility="All"
                                          Background="White"
                                          Margin="0,0,0,15"
                                          ItemsSource="{Binding Clients}"
                                          SelectionChanged="DataGrid_SelectionChanged"
                                          LoadingRow="DataGrid_LoadingRow"
                                          HorizontalScrollBarVisibility="Disabled">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Фамилия" Binding="{Binding ChildSurname}" Width="120"/>
                                        <DataGridTextColumn Header="Имя" Binding="{Binding ChildName}" Width="100"/>
                                        <DataGridTextColumn Header="Родители" Binding="{Binding ParentName}" Width="200"/>
                                        <DataGridTextColumn Header="Телефон" Binding="{Binding ParentPhone}" Width="120"/>
                                        <DataGridTextColumn Header="Смена" Binding="{Binding Shift}" Width="60"/>
                                        <DataGridTextColumn Header="ДР" Binding="{Binding BirthDate, StringFormat={}{0:dd.MM.yyyy}}" Width="*" MinWidth="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Right Panel: Edit Form -->
            <Border Grid.Column="1" Background="#F5F5F5" CornerRadius="8" Padding="15" 
                    BorderBrush="#DDD" BorderThickness="1" Margin="10,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="ФИО ребенка:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="txtChildSurname" Tag="Фамилия"/>
                        <TextBox Grid.Column="2" x:Name="txtChildName" Tag="Имя"/>
                        <TextBox Grid.Column="4" x:Name="txtChildPatronymic" Tag="Отчество"/>
                    </Grid>

                    <TextBlock Text="ФИО родителя:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtParentName" Margin="0,0,0,10"/>

                    <TextBlock Text="Номер телефона:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtPhone" Margin="0,0,0,10" PreviewTextInput="PhoneValidation"/>

                    <TextBlock Text="Возраст:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtAge" Margin="0,0,0,10" PreviewTextInput="NumberValidation"/>

                    <TextBlock Text="Дата рождения:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <DatePicker x:Name="dpBirthDate" Margin="0,0,0,10"/>

                    <TextBlock Text="Группа (Направление):" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cbGroup" Margin="0,0,0,10" 
                              DisplayMemberPath="Name" SelectedValuePath="Id"/>

                    <TextBlock Text="Смена:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtShift" Margin="0,0,0,10" 
                             ToolTip="Например: 1, 2, или утренняя/вечерняя"/>

                    <TextBlock Text="Комментарий:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtComment" Height="60" TextWrapping="Wrap" 
                             AcceptsReturn="True" Margin="0,0,0,15"/>

                    <WrapPanel HorizontalAlignment="Center">
                        <Button Content="Очистить" Width="120" Height="30" Margin="5" Click="clear_btn_Click" Background="#E5E5E5" BorderBrush="Transparent"/>
                        <Button Content="Сохранить" Width="120" Height="30" Margin="5" Click="save_btn_Click" Background="#E5E5E5" BorderBrush="Transparent"/>
                        <Button Content="Удалить" Width="120" Height="30" Margin="5" Click="delete_btn_Click" Background="#E5E5E5" BorderBrush="Transparent"/>
                        <Button Content="Обновить" Width="120" Height="30" Margin="5" Click="update_btn_Click" Background="#E5E5E5" BorderBrush="Transparent"/>
                    </WrapPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" Background="#FF0068">
            <!--<Button HorizontalAlignment="Left" Background="Transparent" BorderBrush="Transparent" 
                    Margin="20,0,0,0" Cursor="Hand" ToolTip="Добавить клиента" Click="BtnAddNew_Click">
                <TextBlock Text="✏️" FontSize="26" Foreground="White"/>
            </Button>-->
        </Grid>
    </Grid>
</Window>
