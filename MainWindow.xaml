<Window x:Class="LAM_App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LAM_App"
        mc:Ignorable="d"
        Title="LAM" Height="750" Width="1400"
        WindowStartupLocation="CenterScreen">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <!--Header-->
            <RowDefinition Height="*"/>
            <!--Main body-->
            <RowDefinition Height="65"/>
            <!--Footer-->
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#FF0068">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!--Логотип -->
            <Image Source="/Resources/Снимок экрана_10-5-2026_71352_.jpeg" Margin="10,0,0,3" HorizontalAlignment="Left" Stretch="Uniform" Grid.ColumnSpan="2" Width="103"/>

            <!-- Кнопка меню-->
            <Button Grid.Column="2" Name="menu_btn" Width="60" Background="Transparent" BorderBrush="Transparent" 
                     Margin="0,0,15,0" ToolTip="Открыть меню" Click="menu_btn_Click">
                <Image Source="/Resources/меню иконка.png" Height="35" Stretch="Uniform" Cursor="Hand"/>
            </Button>

            <!-- Выпадающее меню -->
            <Popup Name="menuPopup" Placement="Right" PlacementTarget="{Binding ElementName=menu_btn}" 
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="#FFB6D4" BorderBrush="#FF0068" BorderThickness="2" CornerRadius="8" Padding="5" Width="200">
                    <StackPanel>
                        <Button Content="Клиенты" Height="45" Background="#FFB6D4" BorderBrush="Transparent" 
                                FontSize="16" Cursor="Hand" Margin="0,0,0,2" Click="clients_btn_Click"/>
                        <Button Content="Тренеры" Height="45" Background="#FFB6D4" BorderBrush="Transparent" 
                                FontSize="16" Cursor="Hand" Margin="0,0,0,2" Click="teachers_btn_Click"/>
                        <Button Content="Направления" Height="45" Background="#FFB6D4" BorderBrush="Transparent" 
                                FontSize="16" Cursor="Hand" Click="styles_btn_Click"/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid Background="White" MinWidth="1100" MinHeight="560">
            <!-- Делим основную часть-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="20" Background="#f60068" CornerRadius="8" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Заметки" FontSize="28" FontWeight="SemiBold"
                               Foreground="White" Margin="0,0,0,12"/>

                    <DataGrid Grid.Row="1" x:Name="dgNotes" AutoGenerateColumns="False"
                              IsReadOnly="True" SelectionMode="Single"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              Background="White"
                              AlternatingRowBackground="#FFF0F6"
                              RowHeight="32"
                              SelectionChanged="dgNotes_SelectionChanged"
                              HorizontalScrollBarVisibility="Disabled"
                              ColumnWidth="SizeToHeader">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" Binding="{Binding NoteDate, StringFormat={}{0:dd.MM.yyyy}}" Width="120" MinWidth="120"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="140" MinWidth="140"/>
                            <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="*" MinWidth="300"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Background="#FFE1EE" CornerRadius="6" Padding="12" Margin="0,14,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,18,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="Дата" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <DatePicker x:Name="dpNoteDate" Height="30"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <TextBlock Text="Статус" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cbNoteStatus" Height="30" SelectedIndex="0">
                                        <ComboBoxItem Content="Задача"/>
                                        <ComboBoxItem Content="Отчет"/>
                                        <ComboBoxItem Content="Комментарий"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,18,0">
                                <TextBlock Text="Комментарий" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtNoteComment" MinHeight="92"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Bottom">
                                <Button Content="Сохранить" Width="120" Height="30" Margin="0,0,0,8"
                                        Background="White" BorderBrush="Transparent" Cursor="Hand"
                                        Click="saveNote_btn_Click"/>
                                <Button Content="Очистить" Width="120" Height="30" Margin="0,0,0,8"
                                        Background="White" BorderBrush="Transparent" Cursor="Hand"
                                        Click="clearNote_btn_Click"/>
                                <Button Content="Удалить" Width="120" Height="30"
                                        Background="White" BorderBrush="Transparent" Cursor="Hand"
                                        Click="deleteNote_btn_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Margin="20,0,20,0" VerticalAlignment="Center">
                <Button Name="attendance_btn" Content="Посещаемость" Height="40" Margin="0,0,0,15" Background="#E5E5E5" BorderBrush="Transparent" FontSize="18" FontWeight="Medium" Cursor="Hand" AutomationProperties.Name="attendance_btn" Click="attendance_btn_Click"/>
                <Button Name="payment_btn" Content="Оплаты" Height="40" Margin="0,0,0,15" Background="#E5E5E5" BorderBrush="Transparent" FontSize="18" FontWeight="Medium" Cursor="Hand" Click="payment_btn_Click"/>
                <Button Name="trial_btn" Content="Пробные" Height="40" Margin="0,0,0,15" Background="#E5E5E5" BorderBrush="Transparent" FontSize="18" FontWeight="Medium" Cursor="Hand" Click="trial_btn_Click"/>
                <Button Name="timetable_btn" Content="Расписание" Height="40" Margin="0,0,0,15" Background="#E5E5E5" BorderBrush="Transparent" FontSize="18" FontWeight="Medium" Cursor="Hand" Click="timetable_btn_Click"/>
                <Button Name="price_btn" Content="Цены" Height="40" Margin="0,0,0,15" Background="#E5E5E5" BorderBrush="Transparent" FontSize="18" FontWeight="Medium" Cursor="Hand" AutomationProperties.Name="price_btn" Click="price_btn_Click"/>
            </StackPanel>
        </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" Background="#FF0068">
            <!--Кнопка для записей
            <Button Name="note_btn1" HorizontalAlignment="Left" Background="Transparent" BorderBrush="Transparent" Margin="20,0,0,0" Cursor="Hand" ToolTip="Добавить запись" Click="note_btn1_Click">
                <TextBlock Name="note_image" Text="✏️" FontSize="26" Foreground="White" Cursor="ArrowCD"/>
            </Button> -->
        </Grid>
    </Grid>
</Window>
