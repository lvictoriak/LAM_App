<Window x:Class="LAM_App.StylesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Направления" Height="750" Width="1400"
        WindowStartupLocation="CenterScreen">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="95"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="65"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#FF0068">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Click="Logo_Click" Background="Transparent" BorderBrush="Transparent"
                    Cursor="Hand" Margin="18,0,0,0">
                <Image Source="/Resources/Снимок экрана_10-5-2026_71352_.jpeg" Height="65" Stretch="Uniform"/>
            </Button>

            <TextBlock Grid.Column="1" Text="Направления" FontSize="46" FontWeight="Medium"
                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <Button Grid.Column="2" Name="menu_btn" Width="90" Background="Transparent" BorderBrush="Transparent"
                    Margin="0,0,18,0" ToolTip="Открыть меню" Click="menu_btn_Click">
                <Image Source="/Resources/меню иконка.png" Height="54" Stretch="Uniform" Cursor="Hand"/>
            </Button>

            <Popup Name="menuPopup" Placement="Right" PlacementTarget="{Binding ElementName=menu_btn}"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="#FFB6D4" BorderBrush="#FF0068" BorderThickness="2" CornerRadius="8" Padding="5" Width="200">
                    <StackPanel>
                        <Button Content="Клиенты" Height="45" Background="#FFB6D4" BorderBrush="Transparent"
                                FontSize="16" Cursor="Hand" Margin="0,0,0,2" Click="clients_btn_Click"/>
                        <Button Content="Тренеры" Height="45" Background="#FFB6D4" BorderBrush="Transparent"
                                FontSize="16" Cursor="Hand" Margin="0,0,0,2" Click="teachers_btn_Click"/>
                        <Button Content="Направления" Height="45" Background="#FFB6D4" BorderBrush="Transparent"
                                FontSize="16" Cursor="Hand" Click="styles_btn_Click"/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="14,18,20,20" MinWidth="1100" MinHeight="560">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="dgStyles" Grid.Column="0" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Single"
                      SelectionChanged="dgStyles_SelectionChanged"
                      CanUserAddRows="False"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="All"
                      AlternatingRowBackground="#F0F0F0"
                      RowHeight="26"
                      FontSize="13"
                      Margin="0,0,24,0"
                      HorizontalScrollBarVisibility="Disabled">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Код" Binding="{Binding Id}" Width="55"/>
                    <DataGridTextColumn Header="Направление" Binding="{Binding Name}" Width="190"/>
                    <DataGridTextColumn Header="Варианты расписания" Binding="{Binding ScheduleOptions}" Width="260"/>
                    <DataGridTextColumn Header="Преподаватели" Binding="{Binding TeacherName}" Width="*" MinWidth="220"/>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#D9D9D9" CornerRadius="5" Padding="10" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Направление:" FontSize="20" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtName" Height="24" Margin="0,0,0,16"/>

                        <TextBlock Text="Варианты расписания:" FontSize="20" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtScheduleOptions" Height="24" Margin="0,0,0,16"/>

                        <TextBlock Text="Преподаватели:" FontSize="20" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtTeachers" Height="24"
                                 ToolTip="Введите ФИО преподавателя как в окне тренеров"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0,0,0,28">
                    <Button Content="Очистить" Height="32" Margin="0,0,0,16"
                            Click="clear_btn_Click" Background="#D9D9D9" BorderBrush="Transparent"
                            FontSize="18" Cursor="Hand"/>
                    <Button Content="Сохранить" Height="32" Margin="0,0,0,16"
                            Click="save_btn_Click" Background="#D9D9D9" BorderBrush="Transparent"
                            FontSize="18" Cursor="Hand"/>
                    <Button Content="Удалить" Height="32" Margin="0,0,0,16"
                            Click="delete_btn_Click" Background="#D9D9D9" BorderBrush="Transparent"
                            FontSize="18" Cursor="Hand"/>
                    <Button Content="Обновить" Height="32"
                            Click="update_btn_Click" Background="#D9D9D9" BorderBrush="Transparent"
                            FontSize="18" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" Background="#FF0068">
            <!--<Button Name="note_btn1" HorizontalAlignment="Left" Background="Transparent" BorderBrush="Transparent"
                    Margin="20,0,0,0" Cursor="Hand" ToolTip="Добавить направление" Click="BtnAddNew_Click">
                <TextBlock Name="note_image" Text="✏️" FontSize="32" Foreground="White"/>
            </Button>-->
        </Grid>
    </Grid>
</Window>
