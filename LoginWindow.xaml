<Window x:Class="LAM_App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в систему" Height="150" Width="300"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Введите пароль от базы данных:" Margin="0,0,0,10"/>

        <PasswordBox x:Name="txtPassword" Grid.Row="1" Margin="0,0,0,10" PasswordChanged="TxtPassword_TextChanged"/>

        <Button x:Name="btnLogin" Content="Войти" Grid.Row="2" HorizontalAlignment="Center" 
                Width="100" Height="20" Click="BtnLogin_Click" IsEnabled="False" IsDefault="True"/>
    </Grid>
</Window>