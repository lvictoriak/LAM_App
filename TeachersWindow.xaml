<Window x:Class="LAM_App.TeachersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Тренеры" Height="750" Width="1400"
        WindowStartupLocation="CenterScreen">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Background="#FF0068">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Logo -->
            <Button Grid.Column="0" Click="Logo_Click" Background="Transparent" BorderBrush="Transparent" Cursor="Hand" Margin="10,0,0,0">
                <Image Source="/Resources/Снимок экрана_10-5-2026_71352_.jpeg" Height="45" Stretch="Uniform"/>
            </Button>

            <TextBlock Grid.Column="1" Text="Тренеры" FontSize="32" FontWeight="Medium" 
                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <Button Grid.Column="2" Name="menu_btn" Width="60" Background="Transparent" BorderBrush="Transparent" 
                    Margin="0,0,15,0" ToolTip="Открыть меню" Click="menu_btn_Click">
                <Image Source="/Resources/меню иконка.png" Height="35" Stretch="Uniform" Cursor="Hand"/>
            </Button>
            
            <Popup Name="menuPopup" Placement="Right" PlacementTarget="{Binding ElementName=menu_btn}" 
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="#FFB6D4" BorderBrush="#FF0068" BorderThickness="2" CornerRadius="8" Padding="5" Width="200">
                    <StackPanel>
                        <Button Content="Клиенты" Height="45" Background="#FFB6D4" BorderBrush="Transparent" 
                            FontSize="16" Cursor="Hand" Margin="0,0,0,2" Click="clients_btn_Click"/>
                        <Button Content="Тренеры" Height="45" Background="#FFB6D4" BorderBrush="Transparent" 
                            FontSize="16" Cursor="Hand" Margin="0,0,0,2" Click="teachers_btn_Click"/>
                        <Button Content="Направления" Height="45" Background="#FFB6D4" BorderBrush="Transparent" 
                            FontSize="16" Cursor="Hand" Click="styles_btn_Click"/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid Margin="10" MinWidth="1100" MinHeight="600">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="dgTeachers" Grid.Row="0" AutoGenerateColumns="False" 
                      IsReadOnly="False" SelectionMode="Single"
                      SelectionChanged="dgTeachers_SelectionChanged"
                      CanUserAddRows="False"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="All"
                      AlternatingRowBackground="#F5F5F5"
                      RowHeight="35">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ко" Binding="{Binding Id}" Width="40" IsReadOnly="True"/>
                    <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="200"/>
                    <DataGridTextColumn Header="Номер телефона" Binding="{Binding Phone}" Width="120"/>
                    <DataGridTextColumn Header="Возраст" Binding="{Binding Age}" Width="60"/>
                    <DataGridTextColumn Header="Направление" Binding="{Binding DirectionsText}" Width="200"/>
                    <DataGridTextColumn Header="Танцевальный опыт" Binding="{Binding DanceExperience}" Width="150"/>
                    <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="1" Background="#F5F5F5" CornerRadius="8" Padding="15" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="ФИО:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtFullName" Margin="0,0,0,10" Height="25"/>

                        <TextBlock Text="Номер телефона:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtPhone" Margin="0,0,0,10" Height="25" PreviewTextInput="PhoneValidation"/>

                        <TextBlock Text="Возраст:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtAge" Margin="0,0,0,10" Height="25" PreviewTextInput="NumberValidation"/>

                        <TextBlock Text="Направление:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtDirections" Margin="0,0,0,10" Height="25" 
                                 ToolTip="Перечислите направления через точку с запятой"/>

                        <TextBlock Text="Танцевальный опыт:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtDanceExperience" Margin="0,0,0,10" Height="25"/>

                        <TextBlock Text="Комментарий:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtComment" Margin="0,0,0,10" Height="60" 
                                 TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="10,0">
                        <Button Content="Очистить" Width="120" Height="35" Margin="0,5" 
                            Click="clear_btn_Click" Background="#E5E5E5" BorderBrush="Transparent" Cursor="Hand"/>
                        <Button Content="Сохранить" Width="120" Height="35" Margin="0,5" 
                            Click="save_btn_Click" Background="#E5E5E5" BorderBrush="Transparent" Cursor="Hand"/>
                        <Button Content="Удалить" Width="120" Height="35" Margin="0,5" 
                            Click="delete_btn_Click" Background="#E5E5E5" BorderBrush="Transparent" Cursor="Hand"/>
                        <Button Content="Обновить" Width="120" Height="35" Margin="0,5" 
                            Click="update_btn_Click" Background="#E5E5E5" BorderBrush="Transparent" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" Background="#FF0068">
            <Button HorizontalAlignment="Left" Background="Transparent" BorderBrush="Transparent" 
                    Margin="20,0,0,0" Cursor="Hand" ToolTip="Добавить тренера" Click="BtnAddNew_Click">
                <TextBlock Text="✏️" FontSize="26" Foreground="White"/>
            </Button>
        </Grid>
    </Grid>
</Window>
