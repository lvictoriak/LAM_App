<Window x:Class="LAM_App.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотр изображения" Height="750" Width="1000"
        WindowStartupLocation="CenterOwner">
    <Grid Background="#1A1A1A">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#FF0068" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="-" Width="44" Height="32" Margin="14,0,8,0"
                    Background="#D9D9D9" BorderBrush="Transparent" Click="zoomOut_btn_Click"/>
            <Slider Grid.Column="1" x:Name="zoomSlider" Minimum="0.2" Maximum="4" Value="1"
                    SmallChange="0.1" LargeChange="0.25" VerticalAlignment="Center"/>
            <Button Grid.Column="2" Content="+" Width="44" Height="32" Margin="8,0"
                    Background="#D9D9D9" BorderBrush="Transparent" Click="zoomIn_btn_Click"/>
            <Button Grid.Column="3" Content="100%" Width="70" Height="32" Margin="8,0"
                    Background="#D9D9D9" BorderBrush="Transparent" Click="resetZoom_btn_Click"/>
            <TextBlock Grid.Column="4" Text="{Binding ElementName=zoomSlider, Path=Value, StringFormat={}{0:P0}}"
                       Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <Button Grid.Column="6" Content="Закрыть" Width="110" Height="32" Margin="0,0,14,0"
                    Background="#D9D9D9" BorderBrush="Transparent" Click="close_btn_Click"/>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      PreviewMouseWheel="viewerScroll_PreviewMouseWheel">
            <Grid>
                <Image x:Name="viewerImage" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding ElementName=zoomSlider, Path=Value}"
                                        ScaleY="{Binding ElementName=zoomSlider, Path=Value}"/>
                    </Image.LayoutTransform>
                </Image>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
