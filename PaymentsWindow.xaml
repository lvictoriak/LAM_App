<Window x:Class="LAM_App.PaymentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оплаты" Height="750" Width="1400"
        WindowStartupLocation="CenterScreen">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Background="#FF0068">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Логотип = переход на главную -->
            <Button Grid.Column="0" Click="Logo_Click" Background="Transparent" BorderBrush="Transparent" Cursor="Hand" Margin="10,0,0,0">
                <Image Source="/Resources/Снимок экрана_10-5-2026_71352_.jpeg" Height="45" Stretch="Uniform"/>
            </Button>

            <TextBlock Grid.Column="1" Text="Оплаты" FontSize="32" FontWeight="Medium" 
                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Кнопка меню -->
            <Button Grid.Column="2" Name="menu_btn" Width="60" Background="Transparent" BorderBrush="Transparent" 
                    Margin="0,0,15,0" ToolTip="Открыть меню" Click="menu_btn_Click">
                <Image Source="/Resources/меню иконка.png" Height="35" Stretch="Uniform" Cursor="Hand"/>
            </Button>

            <Popup Name="menuPopup" Placement="Right" PlacementTarget="{Binding ElementName=menu_btn}" 
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="#FFB6D4" BorderBrush="#FF0068" BorderThickness="2" CornerRadius="8" Padding="5" Width="200">
                    <StackPanel>
                        <Button Content="Клиенты" Height="45" Background="#FFB6D4" BorderBrush="Transparent" 
                                FontSize="16" Cursor="Hand" Margin="0,0,0,2" FontStyle="Oblique" Click="clients_btn_Click"/>
                        <Button Content="Тренеры" Height="45" Background="#FFB6D4" BorderBrush="Transparent" 
                                FontSize="16" Cursor="Hand" Margin="0,0,0,2" Click="teachers_btn_Click"/>
                        <Button Content="Направления" Height="45" Background="#FFB6D4" BorderBrush="Transparent" 
                                FontSize="16" Cursor="Hand" Click="styles_btn_Click"/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel Margin="10" MinWidth="1100">
                <!--Таблица платежей -->
                <Border BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,10">
                    <DataGrid x:Name="dgPayments" AutoGenerateColumns="False" 
                              Height="300" IsReadOnly="False" 
                              SelectionMode="Single"
                              SelectionChanged="dgPayments_SelectionChanged"
                              CanUserAddRows="False"
                              GridLinesVisibility="All"
                              HeadersVisibility="All">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата начисления" Binding="{Binding PaymentDate, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                            <DataGridTextColumn Header="Приход" Binding="{Binding Income}" Width="80"/>
                            <DataGridTextColumn Header="Расход" Binding="{Binding Expense}" Width="80"/>
                            <DataGridTextColumn Header="Касса / Расчетный счет" Binding="{Binding PaymentTypeName}" Width="120"/>
                            <DataGridTextColumn Header="Статья" Binding="{Binding CategoryName}" Width="150"/>
                            <DataGridTextColumn Header="Направление" Binding="{Binding StyleName}" Width="120"/>
                            <DataGridTextColumn Header="Контрагент" Binding="{Binding Contractor}" Width="150"/>
                            <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Форма ввода -->
                <GroupBox Header="Данные платежа" Margin="0,0,0,10" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="250"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Дата:" Margin="0,5" VerticalAlignment="Center"/>
                            <DatePicker Grid.Row="0" Grid.Column="1" x:Name="dpPaymentDate" Margin="5"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Приход:" Margin="0,5" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtIncome" Margin="5" PreviewTextInput="NumberValidation"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Расход:" Margin="0,5" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtExpense" Margin="5" PreviewTextInput="NumberValidation"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Вид оплаты:" Margin="0,5" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="cbPaymentType" Margin="5" DisplayMemberPath="Name" SelectedValuePath="Id"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Статья:" Margin="0,5" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="4" Grid.Column="1" x:Name="cbCategory" Margin="5" DisplayMemberPath="Name" SelectedValuePath="Id"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Направление:" Margin="0,5" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="5" Grid.Column="1" x:Name="cbStyle" Margin="5" DisplayMemberPath="Name" SelectedValuePath="Id"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Контрагент:" Margin="0,5" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="6" Grid.Column="1" x:Name="txtContractor" Margin="5"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Комментарий:" Margin="0,5" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="7" Grid.Column="1" x:Name="txtComment" Margin="5"/>
                        </Grid>

                        <!-- Кнопки -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="10,0">
                            <Button Content="Очистить" Width="120" Height="35" Margin="0,5" 
                                    Click="clear_btn_Click" Background="#E5E5E5" BorderBrush="Transparent" Cursor="Hand"/>
                            <Button Content="Сохранить" Width="120" Height="35" Margin="0,5" 
                                    Click="save_btn_Click" Background="#E5E5E5" BorderBrush="Transparent" Cursor="Hand"/>
                            <Button Content="Удалить" Width="120" Height="35" Margin="0,5" 
                                    Click="delete_btn_Click" Background="#E5E5E5" BorderBrush="Transparent" Cursor="Hand"/>
                            <Button Content="Обновить" Width="120" Height="35" Margin="0,5" 
                                    Click="update_btn_Click" Background="#E5E5E5" BorderBrush="Transparent" Cursor="Hand"/>
                        </StackPanel>

                        <GroupBox Grid.Column="2" Header="Должники" Margin="10,0,0,0" VerticalAlignment="Top">
                            <DataGrid x:Name="dgDebtors" AutoGenerateColumns="False" Height="200" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ребенок" Binding="{Binding ChildName}" Width="120"/>
                                    <DataGridTextColumn Header="Направление" Binding="{Binding StyleName}" Width="100"/>
                                    <DataGridTextColumn Header="Абонемент" Binding="{Binding SubscriptionInfo}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" Background="#FF0068">
            <Button Content="Отчет" FontSize="18" FontWeight="Medium" 
                    HorizontalAlignment="Right" Width="200" Height="40" Margin="0,0,20,0"
                    Click="report_btn_Click" Background="#1a1a2e" Foreground="White" 
                    BorderBrush="Transparent" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
