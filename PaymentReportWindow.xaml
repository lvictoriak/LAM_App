<Window x:Class="LAM_App.PaymentReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отчет по оплатам" Height="400" Width="500"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Период отчета" FontSize="18" FontWeight="Medium" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="С:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <DatePicker x:Name="dpFromDate" Width="150" Margin="0,0,20,0"/>
            <TextBlock Text="По:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <DatePicker x:Name="dpToDate" Width="150"/>
        </StackPanel>

        <Button Grid.Row="2" Content="Сформировать отчет" Width="200" Height="35" 
                Click="BtnGenerateReport_Click" Background="#FF0068" Foreground="White"
                BorderBrush="Transparent" Cursor="Hand" Margin="0,0,0,20"/>

        <GroupBox Grid.Row="3" Header="Итоги" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Общий доход:" Margin="0,5"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtTotalIncome" Text="0.00 ₽" FontWeight="Bold" Foreground="Green" Margin="0,5"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Общий расход:" Margin="0,5"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtTotalExpense" Text="0.00 ₽" FontWeight="Bold" Foreground="Red" Margin="0,5"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Чистая прибыль:" Margin="0,5"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtNetProfit" Text="0.00 ₽" FontWeight="Bold" FontSize="14" Margin="0,5"/>
            </Grid>
        </GroupBox>

        <Button Grid.Row="5" Content="Закрыть" Width="100" Height="30" 
                Click="BtnClose_Click" HorizontalAlignment="Right"
                Background="#E5E5E5" BorderBrush="Transparent" Cursor="Hand"/>
    </Grid>
</Window>